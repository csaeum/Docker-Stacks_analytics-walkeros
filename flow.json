{
  "version": 4,
  "flows": {
    "default": {
      "config": {
        "platform": "server",
        "bundle": {
          "packages": {
            "@walkeros/collector": { "version": "4.9.0" },
            "@walkeros/server-source-express": { "version": "4.9.0" },
            "@walkeros/destination-demo": { "version": "4.9.0" },
            "@walkeros/server-destination-api": { "version": "4.9.0" },
            "@walkeros/server-destination-meta": { "version": "4.9.0" },
            "@walkeros/server-destination-pinterest": { "version": "4.9.0" }
          }
        }
      },
      "sources": {
        "http": {
          "package": "@walkeros/server-source-express",
          "before": "purchaseAuth",
          "config": {
            "async": { "POST": false },
            "settings": {
              "paths": ["/collect", { "path": "/purchase", "methods": ["POST"] }]
            },
            "ingest": {
              "map": {
                "path": "path",
                "authorization": "headers.authorization",
                "ip": "headers.x-real-ip",
                "userAgent": "headers.user-agent",
                "origin": "headers.origin",
                "cookie": "headers.cookie"
              }
            }
          }
        }
      },
      "transformers": {
        "purchaseAuth": {
          "code": {
            "type": "purchaseAuth",
            "push": "$code:(event, context) => { const ingest = (context && context.ingest) || {}; if (ingest.path !== '/purchase') { return { event }; } const respond = context && context.env && context.env.respond; const deny = (status, error) => { if (respond) { respond({ status, body: { success: false, error } }); } return false; }; const token = process.env.PURCHASE_TOKEN; if (!token) { return deny(503, 'Purchase path disabled'); } const crypto = process.getBuiltinModule('node:crypto'); const given = Buffer.from(String(ingest.authorization || '')); const expected = Buffer.from('Bearer ' + token); if (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) { return deny(401, 'Unauthorized'); } if (!event || event.name !== 'order complete') { return deny(400, 'Only order complete is accepted'); } const orderId = event.data && event.data.id; if (typeof orderId !== 'string' || !orderId) { return deny(400, 'Order id missing'); } const seen = (globalThis.wscPurchaseSeen = globalThis.wscPurchaseSeen || new Map()); const now = Date.now(); seen.forEach((t, key) => { if (now - t > 2592000000) { seen.delete(key); } }); if (seen.has(orderId)) { if (respond) { respond({ body: { success: true, duplicate: true } }); } return false; } seen.set(orderId, now); return { event }; }"
          }
        },
        "requestContext": {
          "code": {
            "type": "requestContext",
            "push": "$code:(event, context) => { const origin = process.env.MATOMO_ORIGIN; const ingest = (context && context.ingest) || {}; if (!origin) { return false; } if (ingest.path === '/purchase') { return { event }; } if (event.name === 'order complete' || ingest.origin !== origin) { return false; } return { event: { ...event, user: { ...event.user, ip: ingest.ip, userAgent: ingest.userAgent } } }; }"
          }
        },
        "meta1Context": {
          "code": {
            "type": "meta1Context",
            "push": "$code:(event, context) => { const origins = (process.env.META_1_ORIGIN || '').split(',').map((o) => o.trim()).filter(Boolean); const ingest = (context && context.ingest) || {}; if (ingest.path === '/purchase') { return { event }; } if (event.name === 'order complete' || !origins.includes(ingest.origin)) { return false; } const store = (globalThis.wscUserData = globalThis.wscUserData || new Map()); const device = event.user && event.user.device; const now = Date.now(); store.forEach((entry, key) => { if (now - entry.t > 1800000) { store.delete(key); } }); if (event.name === 'user data') { const hash = event.data && event.data.email; if (device && typeof hash === 'string' && /^[a-f0-9]{64}$/.test(hash)) { store.set(device, { t: now, em: hash }); } return false; } const known = device ? store.get(device) : undefined; const found = {}; String(ingest.cookie || '').split(';').forEach((part) => { const pair = part.trim(); const i = pair.indexOf('='); if (i > 0 && pair.slice(0, i) === '_fbp' || pair.slice(0, i) === '_fbc') { found[pair.slice(0, i)] = pair.slice(i + 1); } }); let click; try { click = new URL(event.source && event.source.url).searchParams.get('fbclid') || undefined; } catch (error) { click = undefined; } return { event: { ...event, user: { ...event.user, ip: ingest.ip, userAgent: ingest.userAgent, fbp: found._fbp, fbc: found._fbc, fbclid: found._fbc ? undefined : click, em: known ? known.em : undefined } } }; }"
          }
        },
        "pinterest1Context": {
          "code": {
            "type": "pinterest1Context",
            "push": "$code:(event, context) => { const origins = (process.env.PINTEREST_1_ORIGIN || '').split(',').map((o) => o.trim()).filter(Boolean); const ingest = (context && context.ingest) || {}; if (ingest.path === '/purchase') { return { event }; } if (event.name === 'order complete' || !origins.includes(ingest.origin)) { return false; } const store = (globalThis.wscUserData = globalThis.wscUserData || new Map()); const device = event.user && event.user.device; const now = Date.now(); store.forEach((entry, key) => { if (now - entry.t > 1800000) { store.delete(key); } }); if (event.name === 'user data') { const hash = event.data && event.data.email; if (device && typeof hash === 'string' && /^[a-f0-9]{64}$/.test(hash)) { store.set(device, { t: now, em: hash }); } return false; } const known = device ? store.get(device) : undefined; const found = {}; String(ingest.cookie || '').split(';').forEach((part) => { const pair = part.trim(); const i = pair.indexOf('='); if (i > 0 && pair.slice(0, i) === '_epik') { found[pair.slice(0, i)] = pair.slice(i + 1); } }); let click; try { click = new URL(event.source && event.source.url).searchParams.get('epik') || undefined; } catch (error) { click = undefined; } return { event: { ...event, user: { ...event.user, ip: ingest.ip, userAgent: ingest.userAgent, epik: found._epik || click, em: known ? [known.em] : undefined } } }; }"
          }
        }
      },
      "destinations": {
        "console": {
          "package": "@walkeros/destination-demo",
          "config": {
            "settings": {
              "name": "Event Logger",
              "values": ["name", "data.title", "timestamp"]
            }
          }
        },
        "matomo": {
          "package": "@walkeros/server-destination-api",
          "before": "requestContext",
          "config": {
            "consent": { "analytics": true },
            "settings": {
              "url": "$env.MATOMO_URL:",
              "headers": {
                "Content-Type": "application/x-www-form-urlencoded; charset=utf-8"
              },
              "transform": "$code:(data) => new URLSearchParams(Object.entries(data).filter(([, v]) => v !== undefined && v !== null && v !== '').map(([k, v]) => [k, typeof v === 'object' ? JSON.stringify(v) : String(v)])).toString()"
            },
            "data": {
              "map": {
                "idsite": { "value": 12 },
                "rec": { "value": 1 },
                "apiv": { "value": 1 },
                "send_image": { "value": 0 },
                "url": "source.url",
                "urlref": "source.referrer",
                "_id": {
                  "fn": "$code:(event) => { const d = event.user && event.user.device; return d ? d.split('').map((c) => (parseInt(c, 36) % 16).toString(16)).join('').padEnd(16, '0').slice(0, 16) : undefined; }"
                },
                "cip": "user.ip",
                "ua": "user.userAgent",
                "lang": "user.language",
                "res": "user.screenSize",
                "token_auth": { "value": "$env.MATOMO_TOKEN_AUTH:" }
              }
            },
            "mapping": {
              "page": {
                "view": {
                  "data": { "map": { "action_name": "data.title" } }
                },
                "scroll_25": { "data": { "map": { "e_c": { "value": "Scroll" }, "e_a": { "value": "depth" }, "e_v": { "value": 25 } } } },
                "scroll_50": { "data": { "map": { "e_c": { "value": "Scroll" }, "e_a": { "value": "depth" }, "e_v": { "value": 50 } } } },
                "scroll_75": { "data": { "map": { "e_c": { "value": "Scroll" }, "e_a": { "value": "depth" }, "e_v": { "value": 75 } } } },
                "scroll_100": { "data": { "map": { "e_c": { "value": "Scroll" }, "e_a": { "value": "depth" }, "e_v": { "value": 100 } } } },
                "engaged_15": { "data": { "map": { "e_c": { "value": "Engagement" }, "e_a": { "value": "seconds" }, "e_v": { "value": 15 } } } },
                "engaged_30": { "data": { "map": { "e_c": { "value": "Engagement" }, "e_a": { "value": "seconds" }, "e_v": { "value": 30 } } } },
                "engaged_60": { "data": { "map": { "e_c": { "value": "Engagement" }, "e_a": { "value": "seconds" }, "e_v": { "value": 60 } } } }
              },
              "search": {
                "view": { "data": { "map": { "e_c": { "value": "Search" }, "e_a": { "value": "query" }, "e_n": "data.term" } } }
              },
              "file": {
                "download": {
                  "data": { "map": { "e_c": { "value": "Download" }, "e_a": { "key": "data.type", "value": "file" }, "e_n": "data.name" } }
                }
              },
              "link": {
                "outbound": {
                  "data": { "map": { "link": { "fn": "$code:(event) => event.data && event.data.host ? 'https://' + event.data.host : undefined" } } }
                }
              },
              "contact": {
                "click": { "data": { "map": { "e_c": { "value": "Contact" }, "e_a": { "key": "data.kind", "value": "click" } } } }
              },
              "cta": {
                "click": { "data": { "map": { "e_c": { "value": "CTA" }, "e_a": { "value": "click" }, "e_n": "data.name" } } }
              },
              "teaser": {
                "click": { "data": { "map": { "e_c": { "value": "Teaser" }, "e_a": { "value": "click" }, "e_n": "data.name" } } },
                "visible": { "data": { "map": { "e_c": { "value": "Teaser" }, "e_a": { "value": "visible" }, "e_n": "data.name" } } }
              },
              "accordion": {
                "toggle": { "data": { "map": { "e_c": { "value": "Accordion" }, "e_a": { "value": "toggle" }, "e_n": "data.name" } } }
              },
              "share": {
                "click": { "data": { "map": { "e_c": { "value": "Share" }, "e_a": { "value": "click" } } } }
              },
              "form": {
                "submit": { "data": { "map": { "e_c": { "value": "Form" }, "e_a": { "value": "submit" } } } }
              },
              "order": {
                "complete": {
                  "data": {
                    "map": {
                      "idgoal": { "value": 0 },
                      "url": { "fn": "$code:(event) => (event.source && event.source.url) || process.env.MATOMO_ORIGIN" },
                      "ec_id": "data.id",
                      "revenue": "data.value",
                      "ec_st": { "fn": "$code:(event) => { const d = event.data || {}; return typeof d.value === 'number' ? Math.round((d.value - (d.shipping || 0)) * 100) / 100 : undefined; }" },
                      "ec_tx": "data.tax",
                      "ec_sh": "data.shipping",
                      "ec_items": {
                        "fn": "$code:(event) => (Array.isArray(event.nested) ? event.nested : []).filter((n) => n && n.entity === 'product').map((n) => [String((n.data || {}).id || ''), String((n.data || {}).name || ''), String((n.data || {}).category || ''), (n.data || {}).price, (n.data || {}).quantity || 1])"
                      }
                    }
                  }
                }
              },
              "newsletter": {
                "signup": { "data": { "map": { "e_c": { "value": "Newsletter" }, "e_a": { "value": "signup" } } } }
              },
              "video": {
                "start": { "data": { "map": { "e_c": { "value": "Video" }, "e_a": { "value": "start" }, "e_n": { "fn": "$code:(event) => event.data ? event.data.provider + ':' + event.data.id : undefined" } } } },
                "progress": { "data": { "map": { "e_c": { "value": "Video" }, "e_a": { "value": "progress" }, "e_n": { "fn": "$code:(event) => event.data ? event.data.provider + ':' + event.data.id : undefined" }, "e_v": "data.percent" } } },
                "complete": { "data": { "map": { "e_c": { "value": "Video" }, "e_a": { "value": "complete" }, "e_n": { "fn": "$code:(event) => event.data ? event.data.provider + ':' + event.data.id : undefined" } } } }
              },
              "*": {
                "*": { "ignore": true }
              }
            }
          }
        },
        "meta1": {
          "package": "@walkeros/server-destination-meta",
          "before": "meta1Context",
          "config": {
            "consent": {
              "metaServer": true
            },
            "settings": {
              "accessToken": "$env.META_1_ACCESS_TOKEN:",
              "pixelId": "$env.META_1_PIXEL_ID:",
              "test_event_code": "$env.META_1_TEST_EVENT_CODE:",
            "doNotHash": ["em"],
              "url": "$env.META_1_URL:https://graph.facebook.com/v22.0/",
              "user_data": {
                "fbp": "user.fbp",
                "fbc": "user.fbc",
              "fbclid": "user.fbclid",
              "em": "user.em"
              }
            },
            "mapping": {
              "page": {
                "view": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "PageView"
                      }
                    }
                  }
                }
              },
              "product": {
                "view": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "ViewContent"
                      },
                      "custom_data": {
                        "map": {
                          "content_type": {
                            "value": "product"
                          },
                          "contents": {
                            "set": [
                              {
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": "data.price"
                                }
                              }
                            ]
                          },
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "value": {
                            "fn": "$code:(event) => { const d = event.data || {}; return typeof d.price === \"number\" ? Math.round(d.price * (d.quantity || 1) * 100) / 100 : undefined; }"
                          }
                        }
                      }
                    }
                  }
                },
                "add": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "AddToCart"
                      },
                      "custom_data": {
                        "map": {
                          "content_type": {
                            "value": "product"
                          },
                          "contents": {
                            "set": [
                              {
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": "data.price"
                                }
                              }
                            ]
                          },
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "value": {
                            "fn": "$code:(event) => { const d = event.data || {}; return typeof d.price === \"number\" ? Math.round(d.price * (d.quantity || 1) * 100) / 100 : undefined; }"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "order": {
                "start": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "InitiateCheckout"
                      },
                      "custom_data": {
                        "map": {
                          "content_type": {
                            "value": "product"
                          },
                          "contents": {
                            "loop": [
                              "nested",
                              {
                                "condition": "$code:(e) => typeof e === \"object\" && e !== null && e.entity === \"product\"",
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": "data.price"
                                }
                              }
                            ]
                          },
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "num_items": {
                            "fn": "$code:(event) => Array.isArray(event.nested) ? event.nested.filter((n) => n && n.entity === \"product\").length : 0"
                          },
                          "value": "data.value"
                        }
                      }
                    }
                  }
                },
                "complete": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "Purchase"
                      },
                      "custom_data": {
                        "map": {
                          "content_type": {
                            "value": "product"
                          },
                          "contents": {
                            "loop": [
                              "nested",
                              {
                                "condition": "$code:(e) => typeof e === \"object\" && e !== null && e.entity === \"product\"",
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": "data.price"
                                }
                              }
                            ]
                          },
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "num_items": {
                            "fn": "$code:(event) => Array.isArray(event.nested) ? event.nested.filter((n) => n && n.entity === \"product\").length : 0"
                          },
                          "value": "data.value",
                          "order_id": "data.id"
                        }
                      }
                    }
                  }
                }
              },
              "checkout": {
                "step": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "AddPaymentInfo"
                      },
                      "custom_data": {
                        "map": {
                          "content_type": {
                            "value": "product"
                          },
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "value": "data.value"
                        }
                      }
                    }
                  },
                  "condition": "$code:(event) => !!event.data && event.data.step === \"payment\""
                }
              },
              "*": {
                "*": {
                  "ignore": true
                }
              }
            }
          }
        },
        "pinterest1": {
          "package": "@walkeros/server-destination-pinterest",
          "before": "pinterest1Context",
          "config": {
            "consent": {
              "pinterestServer": true
            },
            "settings": {
              "accessToken": "$env.PINTEREST_1_ACCESS_TOKEN:",
              "adAccountId": "$env.PINTEREST_1_AD_ACCOUNT_ID:",
              "test": "$env.PINTEREST_1_TEST:",
            "doNotHash": ["em"],
              "url": "$env.PINTEREST_1_URL:https://api.pinterest.com/v5/",
              "user_data": {
                "click_id": "user.epik",
              "em": "user.em"
              }
            },
            "mapping": {
              "page": {
                "view": {
                  "ignore": true
                }
              },
              "product": {
                "view": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "page_visit"
                      },
                      "custom_data": {
                        "map": {
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "value": {
                            "fn": "$code:(event) => { const d = event.data || {}; const v = typeof d.price === \"number\" ? d.price * (d.quantity || 1) : undefined; return typeof v === \"number\" ? v.toFixed(2) : undefined; }"
                          },
                          "contents": {
                            "set": [
                              {
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": {
                                    "fn": "$code:(event) => typeof (event.data || {}).price === \"number\" ? event.data.price.toFixed(2) : undefined"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "add": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "add_to_cart"
                      },
                      "custom_data": {
                        "map": {
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "value": {
                            "fn": "$code:(event) => { const d = event.data || {}; const v = typeof d.price === \"number\" ? d.price * (d.quantity || 1) : undefined; return typeof v === \"number\" ? v.toFixed(2) : undefined; }"
                          },
                          "contents": {
                            "set": [
                              {
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": {
                                    "fn": "$code:(event) => typeof (event.data || {}).price === \"number\" ? event.data.price.toFixed(2) : undefined"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "list": {
                "view": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "view_category"
                      }
                    }
                  }
                }
              },
              "order": {
                "complete": {
                  "data": {
                    "map": {
                      "event_name": {
                        "value": "checkout"
                      },
                      "custom_data": {
                        "map": {
                          "currency": {
                            "key": "data.currency",
                            "value": "EUR"
                          },
                          "value": {
                            "fn": "$code:(event) => typeof (event.data || {}).value === \"number\" ? event.data.value.toFixed(2) : undefined"
                          },
                          "order_id": "data.id",
                          "num_items": {
                            "fn": "$code:(event) => Array.isArray(event.nested) ? event.nested.filter((n) => n && n.entity === \"product\").length : 0"
                          },
                          "contents": {
                            "loop": [
                              "nested",
                              {
                                "condition": "$code:(e) => typeof e === \"object\" && e !== null && e.entity === \"product\"",
                                "map": {
                                  "id": "data.id",
                                  "quantity": {
                                    "key": "data.quantity",
                                    "value": 1
                                  },
                                  "item_price": {
                                    "fn": "$code:(event) => typeof (event.data || {}).price === \"number\" ? event.data.price.toFixed(2) : undefined"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "*": {
                "*": {
                  "ignore": true
                }
              }
            }
          }
        }
      },
      "collector": { "run": true }
    }
  }
}
