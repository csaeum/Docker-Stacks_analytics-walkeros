{
  "version": 4,
  "flows": {
    "default": {
      "config": {
        "platform": "server",
        "bundle": {
          "packages": {
            "@walkeros/collector": { "version": "4.9.0" },
            "@walkeros/server-source-express": { "version": "4.9.0" },
            "@walkeros/destination-demo": { "version": "4.9.0" }
          }
        }
      },
      "sources": {
        "http": {
          "package": "@walkeros/server-source-express",
          "config": {
            "settings": {
              "paths": ["/collect"],
              "cors": {
                "origin": [
                  "https://projektleder.de",
                  "https://projektleder.at",
                  "https://projektleder.ch",
                  "https://web-seo-consulting.eu",
                  "https://lichte-kraft.eu"
                ]
              }
            }
          }
        }
      },
      "destinations": {
        "console": {
          "package": "@walkeros/destination-demo",
          "config": {
            "settings": {
              "name": "Event Logger",
              "values": ["name", "data.title", "timestamp"]
            }
          }
        }
      },
      "collector": { "run": true }
    }
  }
}
