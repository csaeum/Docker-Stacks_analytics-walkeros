{
  "version": 4,
  "flows": {
    "web": {
      "config": {
        "platform": "web",
        "bundle": {
          "packages": {
            "@walkeros/collector": { "version": "4.9.0" },
            "@walkeros/web-source-browser": { "version": "4.9.0" },
            "@walkeros/web-source-session": { "version": "4.9.0" },
            "@walkeros/web-destination-api": { "version": "4.9.0" }
          }
        }
      },
      "sources": {
        "browser": {
          "package": "@walkeros/web-source-browser",
          "primary": true,
          "config": {
            "settings": { "pageview": true }
          }
        },
        "session": {
          "package": "@walkeros/web-source-session",
          "config": {
            "settings": {
              "storage": true,
              "consent": ["analytics", "marketing"]
            }
          }
        }
      },
      "transformers": {
        "deviceContext": {
          "code": {
            "type": "deviceContext",
            "push": "$code:(event) => { if (!(event.consent && event.consent.analytics)) return { event }; return { event: { ...event, user: { ...event.user, language: window.navigator.language, screenSize: window.screen.width + 'x' + window.screen.height } } }; }"
          }
        }
      },
      "destinations": {
        "collect": {
          "package": "@walkeros/web-destination-api",
          "before": "deviceContext",
          "config": {
            "consent": { "analytics": true, "marketing": true },
            "settings": {
              "url": "https://collector-host.invalid/collect",
              "transport": "beacon"
            }
          }
        }
      }
    }
  }
}
