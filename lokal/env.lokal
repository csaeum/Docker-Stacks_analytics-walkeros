# env.lokal - walkerOS - START
# Nur fuer die lokale Umgebung. Keine Secrets: Der Matomo-Token steht in .env.lokal.local (gitignored).
COMPOSE_PROJECT_NAME=walkeros-lokal
PROXY_NETWORK=walkeros-lokal
# Matomo im DDEV-Projekt "matomo": Web-Container ueber das DDEV-Netz, Site 12
MATOMO_URL=http://ddev-matomo-web/matomo.php
# Herkunft der lokalen Sulu-Testseite (siehe MATOMO_ORIGIN in flow.json)
MATOMO_ORIGIN=https://sulu-bundles.ddev.site
# env.lokal - walkerOS - ENDE
