# env.lokal - walkerOS - START
# Nur fuer die lokale Umgebung. Keine Secrets: Der Matomo-Token steht in .env.lokal.local (gitignored).
COMPOSE_PROJECT_NAME=walkeros-lokal
PROXY_NETWORK=walkeros-lokal
# Matomo im DDEV-Projekt "matomo": Web-Container ueber das DDEV-Netz, Site 12
MATOMO_URL=http://ddev-matomo-web/matomo.php
# Herkunft der lokalen Sulu-Testseite (siehe MATOMO_ORIGIN in flow.json)
MATOMO_ORIGIN=https://sulu-bundles.ddev.site
# Server-side Meta and Pinterest against the mock (lokal/capi-mock.js), fake tokens, real calls only with .env.lokal.local
META_1_ORIGIN=https://sulu-bundles.ddev.site
META_1_PIXEL_ID=1349349437215794
META_1_ACCESS_TOKEN=lokal-fake-token
META_1_URL=http://capi-mock:9000/meta/
PINTEREST_1_ORIGIN=https://sulu-bundles.ddev.site
PINTEREST_1_AD_ACCOUNT_ID=549000000001
PINTEREST_1_ACCESS_TOKEN=lokal-fake-token
PINTEREST_1_URL=http://capi-mock:9000/pinterest/
# Purchase path with a fake token (local only)
PURCHASE_TOKEN=lokal-purchase-token
# env.lokal - walkerOS - ENDE
