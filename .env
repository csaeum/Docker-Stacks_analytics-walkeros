# .env - walkerOS - START
# ========================================
# TEMPLATE - Vor dem Einsatz alle Platzhalter (example.*) ersetzen!
# Echte Secrets nur in .env.local (gitignored), nie in diese Datei.
# ========================================

# ========================================
# Project Configuration
# ========================================
COMPOSE_PROJECT_NAME=walkeros
TIMEZONE=Europe/Berlin

# ========================================
# Image
# ========================================
# Pinnt CLI und Runtime gemeinsam. Bei Updates auch die Paketversionen in flow.json anpassen.
WALKEROS_VERSION=4.9.0

# ========================================
# Traefik Host-Regel (Mehrfach-Domains via ||)
# ========================================
HOSTRULE=Host(`collect.example.com`)

# ========================================
# Zugriffsschutz fuer /collect
# ========================================
# Erlaubte Website-Domains als Regex, mehrere per | trennen. Zusaetzlich in flow.json unter cors.origin pflegen.
# Beispiel: '^https://(www\.example\.com|shop\.example\.org)$'
ALLOWED_ORIGIN_REGEX='^https://www\.example\.com$'
# Anfragen pro Sekunde und IP (Durchschnitt) sowie erlaubte Spitze
RATE_LIMIT_AVERAGE=20
RATE_LIMIT_BURST=50

# ========================================
# Network
# ========================================
PROXY_NETWORK=traefik_proxy_network
# .env - walkerOS - ENDE
